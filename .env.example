# Django project environment variables
SECRET_KEY=your-secret-key

# Development(True/False)
DEBUG=False 
ALLOWED_HOSTS=["*"]
BASE_DOMAIN="lvh.me"
PUBLIC_TENANT_ADMIN_EMAIL="admin@lvh.me"
PUBLIC_TENANT_ADMIN_PASSWORD="password"

# Production
# DEBUG=False
# BASE_DOMAIN="my-saas.com"
# ALLOWED_HOSTS=".my-saas.com"
# PUBLIC_TENANT_ADMIN_EMAIL="admin@my-saas.com"
# PUBLIC_TENANT_ADMIN_PASSWORD="password"

# Security (Set to True in production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# email credentials for password reset
EMAIL_BACKEND='django.core.mail.backends.smtp.EmailBackend'
EMAIL_USE_TLS=True
EMAIL_HOST='smtp.gmail.com'
EMAIL_PORT=587
EMAIL_USER=your-email
EMAIL_PASS=your-app-password

# PostgreSQL
POSTGRES_USER=django_multi_tenant_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=django_multi_tenant_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_URL=postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@$POSTGRES_HOST:$POSTGRES_PORT/$POSTGRES_DB

# Logging
CONSOLE_LOG_LEVEL=INFO